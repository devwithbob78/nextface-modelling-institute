rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'accountType', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountType in ['adult_learner', 'parent_guardian']
        && request.resource.data.createdAt == request.time;
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /fees/{feeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /timetables/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /support/{ticketId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
